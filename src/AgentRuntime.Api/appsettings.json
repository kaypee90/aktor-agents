{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=aktor_agents;Username=aktor;Password=aktor_dev_password"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RuntimeLimits": {
    "MaxAgentDepth": 5,
    "MaxChildrenPerAgent": 10,
    "MaxTotalAgents": 100,
    "MaxActiveAgents": 50,
    "MaxMessagesPerTask": 500,
    "MaxReasoningIterationsPerTurn": 40,
    "MaxRepeatedIdenticalToolCalls": 3,
    "MinChildTokens": 20000,
    "MinChildToolCalls": 5
  },
  "DefaultBudget": {
    "MaxTokens": 1000000,
    "MaxDurationSeconds": 900,
    "MaxChildren": 5,
    "MaxToolCalls": 400,
    "MaxCostUsd": 4.00
  },
  "Autonomy": {
    "Level": "Autonomous"
  },
  "Supervision": {
    "MaxRetries": 3,
    "FailurePolicy": "Restart"
  },
  "Llm": {
    "Provider": "Mock",
    "Model": "claude-sonnet-5",
    "ApiKey": "",
    "BaseUrl": ""
  },
  "Tools": {
    "WorkspaceRoot": "./workspace",
    "ShellDockerImage": "alpine:3.20",
    "ShellTimeoutSeconds": 30,
    "ShellMemoryLimit": "256m",
    "ShellCpuLimit": "0.5",
    "SearchApiKey": "",
    "DatabaseConnectionString": "Host=localhost;Port=5432;Database=aktor_agents;Username=aktor;Password=aktor_dev_password"
  }
}
