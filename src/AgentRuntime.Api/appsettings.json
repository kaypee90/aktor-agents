{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Orleans": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "Postgres": "Host=localhost;Port=5432;Database=aktor_agents;Username=aktor;Password=aktor_dev_password"
  },
  "Cors": {
    "AllowedOrigins": [ "http://localhost:3000" ]
  },
  "RuntimeLimits": {
    "MaxAgentDepth": 5,
    "MaxChildrenPerAgent": 10,
    "MaxTotalAgents": 100,
    "MaxActiveAgents": 50,
    "MaxMessagesPerTask": 500,
    "MaxReasoningIterationsPerTurn": 40,
    "MaxRepeatedIdenticalToolCalls": 3,
    "MinChildTokens": 20000,
    "MinChildToolCalls": 5
  },
  "DefaultBudget": {
    "MaxTokens": 1000000,
    "MaxDurationSeconds": 900,
    "MaxChildren": 5,
    "MaxToolCalls": 500,
    "MaxCostUsd": 4.00
  },
  "Autonomy": {
    "Level": "Autonomous"
  },
  "Supervision": {
    "MaxRetries": 3,
    "FailurePolicy": "Restart"
  },
  "Integrations": {
    "PublicBaseUrl": "",
    "AllowStdioMcp": false,
    "MaxEnabledToolsPerConnection": 20
  },
  "Secrets": {
    "MasterKey": "",
    "KeyFile": "./keys/secrets-master.key"
  },
  "Plugins": {
    "Directory": "./plugins"
  },
  "Auth": {
    "Mode": "accounts",
    "AllowSignup": true,
    "PlatformAdmins": [],
    "SessionDays": 30,
    "InvitationDays": 7
  },
  "Billing": {
    "Provider": "none",
    "DefaultPlan": "unlimited",
    "LapsedPlan": "",
    "Plans": [
      {
        "Id": "free",
        "Name": "Free",
        "Description": "Try it out.",
        "MonthlyTokenLimit": 2000000,
        "MonthlyCostLimitUsd": 5,
        "MaxWorkspaces": 2,
        "MaxActiveAgents": 10,
        "MaxMembers": 3,
        "PriceMonthlyUsd": 0
      },
      {
        "Id": "pro",
        "Name": "Pro",
        "Description": "For a team running agents every day.",
        "MonthlyTokenLimit": 50000000,
        "MonthlyCostLimitUsd": 150,
        "MaxWorkspaces": 25,
        "MaxActiveAgents": 50,
        "MaxMembers": 20,
        "PriceMonthlyUsd": 99,
        "StripePriceId": ""
      }
    ],
    "Stripe": {
      "SecretKey": "",
      "WebhookSecret": "",
      "AppBaseUrl": "http://localhost:3000"
    }
  },
  "Silo": {
    "Storage": "AdoNet",
    "Clustering": "Localhost"
  },
  "Durability": {
    "RecoveryReminderPeriod": "00:01:00"
  },
  "Simulation": {
    "DefaultTickIntervalSeconds": 15,
    "DefaultMaxTicks": 40,
    "DefaultMaxDurationMinutes": 20,
    "MaxInitialPopulation": 12,
    "MaxPopulation": 20,
    "StartingEnergy": 100,
    "EnergyRegenPerTick": 4,
    "VoteWindowTicks": 3,
    "MinEligibleVoters": 3,
    "ResidentMaxCostUsd": 1.50
  },
  "Llm": {
    "Provider": "Mock",
    "Model": "claude-sonnet-5",
    "ApiKey": "",
    "BaseUrl": "",
    "FastModel": "",
    "FastMaxOutputTokens": 1024,
    "MaxOutputTokens": 4096,
    "CompactAboveTokens": 40000,
    "CompactKeepRecentEntries": 24
  },
  "Tools": {
    "WorkspaceRoot": "./workspace",
    "ShellDockerImage": "alpine:3.20",
    "ShellTimeoutSeconds": 30,
    "ShellMemoryLimit": "256m",
    "ShellCpuLimit": "0.5",
    "SearchProvider": "Tavily",
    "SearchApiKey": "",
    "DatabaseConnectionString": "Host=localhost;Port=5432;Database=aktor_agents;Username=aktor;Password=aktor_dev_password"
  }
}
