{
  "name": "@aktor/sdk",
  "version": "0.1.0",
  "description": "TypeScript client for the Aktor Agents platform API (workspaces, agents, approvals, audit, usage, live events), and aktor-acp, a stdio bridge that runs Aktor as an Agent Client Protocol agent.",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "bin",
    "README.md"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test test/"
  },
  "devDependencies": {
    "typescript": "^5.6.0"
  },
  "bin": {
    "aktor-acp": "./bin/aktor-acp.mjs"
  }
}
