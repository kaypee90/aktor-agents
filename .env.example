# Copy to .env and adjust. docker-compose reads this automatically.
# Never commit a real .env with live credentials.

# --- PostgreSQL ---
POSTGRES_DB=aktor_agents
POSTGRES_USER=aktor
POSTGRES_PASSWORD=aktor_dev_password

# --- LLM provider (CLAUDE.md section 2) ---
# One of: Mock (no key needed, deterministic zero-config demo), Anthropic, OpenAI, Ollama, Gemini (stub).
LLM_PROVIDER=Mock
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=
# Optional cheaper model (same provider) for routine work: standing agents handling events,
# simulation residents and history summaries. e.g. claude-haiku-4-5-20251001 or gpt-4o-mini.
LLM_FAST_MODEL=

# --- Ollama (local models, no API key, no per-token cost) ---
# LLM_PROVIDER=Ollama
# LLM_MODEL=qwen2.5:7b          # must support tool calling: qwen2.5, qwen3, llama3.1, mistral-nemo...
# LLM_BASE_URL=                 # blank = Ollama on the Docker host; http://ollama:11434 for the bundled profile
# LLM_CONTEXT_LENGTH=16384      # context window requested from Ollama (its own default is too small)
# LLM_TIMEOUT_SECONDS=300       # local models can be slow
# LLM_DISABLE_THINKING=true     # tell reasoning models (qwen3, deepseek-r1) not to think; faster

# --- Optional tool integrations ---
# Search provider for the web_search tool: Tavily (free 1,000 credits/month, no card needed —
# sign up at tavily.com) or Brave. Leave the key empty to have web_search report "unavailable".
SEARCH_PROVIDER=Tavily
SEARCH_API_KEY=

# --- Frontend ---
# Baked into the Next.js client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080

# --- Integrations (docs/plugins.md) ---
# Encrypts connection secrets (API tokens, SMTP passwords). Generate with: openssl rand -base64 32
# If empty, a key is generated into the api-keys Docker volume on first start.
SECRETS_MASTER_KEY=
# This server's public URL, needed for inbound SMS/Telegram (providers must reach it) and to
# verify Twilio signatures. e.g. https://agents.example.com
PUBLIC_BASE_URL=
# Allow MCP servers launched as commands (stdio), always inside isolated Docker containers.
ALLOW_STDIO_MCP=false

# --- Platform: accounts, organizations, billing (docs/platform.md) ---
# accounts: everyone signs in (the first account takes over existing data).
# disabled: no sign-in, everyone is the owner; only for a machine nobody else can reach.
AUTH_MODE=accounts
# false: new accounts only by invitation (the very first account can always be created).
AUTH_ALLOW_SIGNUP=true
# The operator's email: may reset the server and set any organization's plan.
PLATFORM_ADMIN_EMAIL=
# none (self-hosted: plans are set by the operator) or stripe. Plans and their limits are
# defined under Billing:Plans in appsettings.json.
BILLING_PROVIDER=none
BILLING_DEFAULT_PLAN=unlimited
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
APP_BASE_URL=http://localhost:3000
