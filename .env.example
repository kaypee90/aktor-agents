# Copy to .env and adjust. docker-compose reads this automatically.
# Never commit a real .env with live credentials.

# --- PostgreSQL ---
POSTGRES_DB=aktor_agents
POSTGRES_USER=aktor
POSTGRES_PASSWORD=aktor_dev_password

# --- LLM provider (CLAUDE.md section 2) ---
# One of: Mock (no key needed, deterministic zero-config demo), Anthropic, OpenAI, Gemini (stub).
LLM_PROVIDER=Mock
LLM_MODEL=claude-sonnet-5
LLM_API_KEY=

# --- Optional tool integrations ---
# Search provider for the web_search tool: Tavily (free 1,000 credits/month, no card needed —
# sign up at tavily.com) or Brave. Leave the key empty to have web_search report "unavailable".
SEARCH_PROVIDER=Tavily
SEARCH_API_KEY=

# --- Frontend ---
# Baked into the Next.js client bundle at build time.
NEXT_PUBLIC_API_BASE_URL=http://localhost:5080
