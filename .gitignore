# .NET
bin/
obj/
*.user

# Node / Next.js
node_modules/
.next/
next-env.d.ts

# Env / secrets
.env
.env.local

# Agent tool workspace (filesystem_write / shell_exec sandbox output). Anchored to where the API
# creates it (Tools:WorkspaceRoot = ./workspace); a bare "workspace/" would also hide source
# folders such as src/web/src/components/workspace.
/workspace/
src/AgentRuntime.Api/workspace/

# Editor / OS
.vs/
.vscode/
*.swp
.DS_Store

# Generated secrets-vault key (Secrets:KeyFile) — never commit it.
/keys/
src/AgentRuntime.Api/keys/
*.key

# Third-party plugin binaries dropped into ./plugins (the folder's README is kept).
/plugins/*
!/plugins/README.md
