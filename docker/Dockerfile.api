FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

COPY src/AgentRuntime.Plugins.Sdk/AgentRuntime.Plugins.Sdk.csproj src/AgentRuntime.Plugins.Sdk/
COPY src/AgentRuntime/AgentRuntime.csproj src/AgentRuntime/
COPY src/AgentRuntime.Infrastructure/AgentRuntime.Infrastructure.csproj src/AgentRuntime.Infrastructure/
COPY src/AgentRuntime.Api/AgentRuntime.Api.csproj src/AgentRuntime.Api/
RUN dotnet restore src/AgentRuntime.Api/AgentRuntime.Api.csproj

COPY src/AgentRuntime.Plugins.Sdk/ src/AgentRuntime.Plugins.Sdk/
COPY src/AgentRuntime/ src/AgentRuntime/
COPY src/AgentRuntime.Infrastructure/ src/AgentRuntime.Infrastructure/
COPY src/AgentRuntime.Api/ src/AgentRuntime.Api/

RUN dotnet publish src/AgentRuntime.Api/AgentRuntime.Api.csproj -c Release -o /app --no-restore

FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# shell_exec sandboxes commands in Docker containers (CLAUDE.md section 19); the API container
# needs the Docker CLI and access to the host daemon socket to launch them.
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/debian/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg \
    && chmod a+r /etc/apt/keyrings/docker.gpg \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/debian bookworm stable" > /etc/apt/sources.list.d/docker.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends docker-ce-cli \
    && rm -rf /var/lib/apt/lists/*

COPY --from=build /app .

ENV ASPNETCORE_URLS=http://+:8080
EXPOSE 8080

ENTRYPOINT ["dotnet", "AgentRuntime.Api.dll"]
